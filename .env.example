# YouTube Data API v3 (path to OAuth 2.0 client secret)
YOUTUBE_CLIENT_SECRET_PATH=./client_secret.json

# YouTube privacy setting (public / unlisted / private)
YOUTUBE_PRIVACY=public

# Channel branding
CHANNEL_NAME=AI News in 60 Seconds
CHANNEL_HASHTAGS=#AINews #TechNews #AI #ShortNews #Shorts
CHANNEL_DESCRIPTION_FOOTER=Daily AI and tech news in 60 seconds.\nSubscribe for the latest updates!

# Background image generation model (SD 1.5 compatible fine-tune models)
# e.g. Lykon/dreamshaper-8, SG161222/Realistic_Vision_V5.1_noVAE
SD_MODEL_ID=Lykon/dreamshaper-8

# edge-tts voice (see https://github.com/rany2/edge-tts for available voices)
TTS_VOICE=en-US-ChristopherNeural

# Context7 MCP (for documentation lookup)
CONTEXT7_API_KEY=...
